<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="370.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.andrewhun.finance.loginpage.LoginPageController">
    <children>
        <Label layoutX="222.0" layoutY="35.0" text="Log In">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
        <Label layoutX="101.0" layoutY="109.0" text="Username:" />
        <TextField fx:id="usernameField" layoutX="183.0" layoutY="105.0" prefHeight="25.0" prefWidth="149.0" />
        <Label layoutX="103.0" layoutY="168.0" text="Password:" />
        <PasswordField fx:id="passwordField" layoutX="183.0" layoutY="164.0" prefHeight="25.0" prefWidth="149.0" />
        <Label fx:id="errorLabel" alignment="CENTER" layoutX="100.0" layoutY="216.0"
               prefHeight="17.0" prefWidth="300.0" textAlignment="CENTER" textFill="red"
               visible="false" managed="false" />
        <Button fx:id="loginButton" layoutX="215.0" layoutY="259.0" mnemonicParsing="false" onAction="#handleLogin" text="Log In" />
        <Hyperlink fx:id="registerLink" layoutX="145.0" layoutY="300.0" onAction="#handleRegisterLink"
                   text="Don't have an account? Register here" />
    </children>
</AnchorPane>